00.000Z","Duration":1,"Predecessor":"17FS","resources":[{"resourceId":"Khalid","resourceName":"Khalid","unit":100}],"Progress":0,"color":"","info":"<p>Saturday: server room, switches, Wi-Fi, printers, phones; test internet and shared drives before Sunday.</p>","DurationUnit":"day"},{"TaskID":20,"TaskName":"Old office final clean-up & key handover – التنظيف النهائي وتسليم مفاتيح المكتب القديم","StartDate":"2026-12-05T05:00:00.000Z","EndDate":"2026-12-05T09:00:00.000Z","Duration":0.5,"Predecessor":"17FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100}],"Progress":0,"color":"","info":"<p>Saturday morning: final sweep, photos, meter readings, keys to the landlord.</p>","DurationUnit":"day"},{"TaskID":21,"TaskName":"Move complete – اكتمال النقل","StartDate":"2026-12-05T14:00:00.000Z","EndDate":"2026-12-05T14:00:00.000Z","Duration":0,"Predecessor":"18FS,19FS,20FS","resources":[],"Progress":0,"color":"","info":"<p><br></p>","DurationUnit":"day"}]},{"TaskID":22,"TaskName":"Settling in – الاستقرار في المكتب الجديد","StartDate":"2026-12-06T05:00:00.000Z","EndDate":"2026-12-16T14:00:00.000Z","Duration":9,"Predecessor":null,"resources":[],"Progress":0,"color":"","info":"<p><br></p>","DurationUnit":"day","subtasks":[{"TaskID":23,"TaskName":"Unpack & set up workstations – فك التغليف وتجهيز محطات العمل","StartDate":"2026-12-06T05:00:00.000Z","EndDate":"2026-12-07T14:00:00.000Z","Duration":2,"Predecessor":"21FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100},{"resourceId":"Sara","resourceName":"Sara","unit":100}],"Progress":0,"color":"","info":"<p>Sunday–Monday: staff unpack their own desks; shared areas, kitchen and meeting rooms set up by the team.</p>","DurationUnit":"day"},{"TaskID":24,"TaskName":"IT support & snag fixing (network, printers, phones) – الدعم التقني ومعالجة ملاحظات الأنظمة","StartDate":"2026-12-06T05:00:00.000Z","EndDate":"2026-12-10T14:00:00.000Z","Duration":5,"Predecessor":"21FS","resources":[{"resourceId":"Khalid","resourceName":"Khalid","unit":100}],"Progress":0,"color":"","info":"<p>First-week support desk; fix connectivity, printing and telephony issues as staff settle in.</p>","DurationUnit":"day"},{"TaskID":25,"TaskName":"Staff orientation & safety briefing at the new building – تعريف الموظفين بالمبنى وإحاطة السلامة","StartDate":"2026-12-08T05:00:00.000Z","EndDate":"2026-12-08T14:00:00.000Z","Duration":1,"Predecessor":"23FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100}],"Progress":0,"color":"","info":"<p>Tour, emergency exits, fire assembly point, access rules, parking, facilities contacts.</p>","DurationUnit":"day"},{"TaskID":26,"TaskName":"Building snag list & fixes with facilities – قائمة الملاحظات وإصلاحها مع إدارة المبنى","StartDate":"2026-12-08T05:00:00.000Z","EndDate":"2026-12-14T14:00:00.000Z","Duration":5,"Predecessor":"23FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100}],"Progress":0,"color":"","info":"<p>Collect issues from staff (AC, lighting, doors, furniture damage) and close them with building management and the movers' insurance.</p>","DurationUnit":"day"},{"TaskID":27,"TaskName":"Return packing materials & close the movers' contract – إعادة مواد التغليف وإقفال عقد شركة النقل","StartDate":"2026-12-09T05:00:00.000Z","EndDate":"2026-12-10T14:00:00.000Z","Duration":2,"Predecessor":"25FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100},{"resourceId":"Moving company (external)","resourceName":"Moving company (external)","unit":100}],"Progress":0,"color":"","info":"<p>Collect empty boxes/crates, sign off the damage report, approve the final invoice.</p>","DurationUnit":"day"},{"TaskID":28,"TaskName":"Close the old office: final bills, deposit & records update – إقفال المكتب القديم: الفواتير النهائية والتأمين وتحديث السجلات","StartDate":"2026-12-13T05:00:00.000Z","EndDate":"2026-12-15T14:00:00.000Z","Duration":3,"Predecessor":"27FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100}],"P