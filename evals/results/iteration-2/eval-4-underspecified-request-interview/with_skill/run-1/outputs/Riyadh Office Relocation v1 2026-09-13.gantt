{"data":[{"TaskID":1,"TaskName":"Preparation – التحضير","StartDate":"2026-11-15T05:00:00.000Z","EndDate":"2026-12-03T14:00:00.000Z","Duration":15,"Predecessor":null,"resources":[],"Progress":0,"color":"","info":"<p><br></p>","DurationUnit":"day","subtasks":[{"TaskID":2,"TaskName":"Kick-off & relocation plan sign-off – اجتماع الانطلاق واعتماد خطة الانتقال","StartDate":"2026-11-15T05:00:00.000Z","EndDate":"2026-11-15T14:00:00.000Z","Duration":1,"Predecessor":"","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100}],"Progress":0,"color":"","info":"<p>Confirm scope, budget, move date (Fri 4 – Sat 5 Dec 2026) and owners with Sara and Khalid.</p>","DurationUnit":"day"},{"TaskID":3,"TaskName":"Inventory of furniture, equipment & files – جرد الأثاث والمعدات والملفات","StartDate":"2026-11-16T05:00:00.000Z","EndDate":"2026-11-18T14:00:00.000Z","Duration":3,"Predecessor":"2FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100}],"Progress":0,"color":"","info":"<p>Room-by-room list; mark what moves, what is disposed of, what is bought new.</p>","DurationUnit":"day"},{"TaskID":4,"TaskName":"Select & contract the moving company – اختيار شركة النقل والتعاقد معها","StartDate":"2026-11-16T05:00:00.000Z","EndDate":"2026-11-22T14:00:00.000Z","Duration":5,"Predecessor":"2FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100}],"Progress":0,"color":"","info":"<p>Three quotes, site visits to both buildings, insurance cover, signed contract.</p>","DurationUnit":"day"},{"TaskID":5,"TaskName":"New building readiness check (power, access, fit-out) – فحص جاهزية المبنى الجديد","StartDate":"2026-11-16T05:00:00.000Z","EndDate":"2026-11-18T14:00:00.000Z","Duration":3,"Predecessor":"2FS","resources":[{"resourceId":"Khalid","resourceName":"Khalid","unit":100}],"Progress":0,"color":"","info":"<p>Walk-through with building management: power, AC, lighting, doors/access control, server room, cabling routes.</p>","DurationUnit":"day"},{"TaskID":6,"TaskName":"Internet & network installation at the new building – تركيب الإنترنت والشبكة في المبنى الجديد","StartDate":"2026-11-19T05:00:00.000Z","EndDate":"2026-11-30T14:00:00.000Z","Duration":8,"Predecessor":"5FS","resources":[{"resourceId":"Khalid","resourceName":"Khalid","unit":100}],"Progress":0,"color":"","info":"<p>ISP order and activation, structured cabling, switches, Wi-Fi, printers and phones.</p>","DurationUnit":"day"},{"TaskID":7,"TaskName":"Order packing materials & labels – طلب مواد التغليف والملصقات","StartDate":"2026-11-19T05:00:00.000Z","EndDate":"2026-11-22T14:00:00.000Z","Duration":2,"Predecessor":"3FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100}],"Progress":0,"color":"","info":"<p>Quantities from the inventory; colour-coded labels per team/room.</p>","DurationUnit":"day"},{"TaskID":8,"TaskName":"Floor plan & seating allocation – مخطط الطوابق وتوزيع المقاعد","StartDate":"2026-11-23T05:00:00.000Z","EndDate":"2026-11-25T14:00:00.000Z","Duration":3,"Predecessor":"7FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100}],"Progress":0,"color":"","info":"<p>Desk-by-desk plan for the new building; label codes match the packing labels.</p>","DurationUnit":"day"},{"TaskID":9,"TaskName":"Moving-day schedule & packing plan with the movers – جدول يوم النقل وخطة التغليف مع شركة النقل","StartDate":"2026-11-23T05:00:00.000Z","EndDate":"2026-11-24T14:00:00.000Z","Duration":2,"Predecessor":"4FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100},{"resourceId":"Moving company (external)","resourceName":"Moving company (external)","unit":100}],"Progress":0,"color":"","info":"<p>Truck timings, lift bookings at both buildings, crew size, fragile/IT handling, contact list.</p>","DurationUnit":"day"},{"TaskID":10,"TaskName":"Access badges, parking & security at the new building – تصاريح الدخول والمواقف والأمن في المبنى الجديد","StartDate":"2026-11-25T05:00:00.000Z","EndDate":"2026-11-29T14:00:00.000Z","Duration":3,"Predecessor":"9FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100}],"Progress":0,"color":"","info":"<p>Badge list for all staff, parking allocation, keys for the moving crew on the weekend.</p>","DurationUnit":"day"},{"TaskID":11,"TaskName":"Notify staff, clients & suppliers; update address records – إبلاغ الموظفين والعملاء والموردين وتحديث بيانات العنوان","StartDate":"2026-11-26T05:00:00.000Z","EndDate":"2026-12-02T14:00:00.000Z","Duration":5,"Predecessor":"8FS","resources":[{"resourceId":"Sara","resourceName":"Sara","unit":100}],"Progress":0,"color":"","info":"<p>Staff briefing, client/supplier notice, bank, commercial registration, Google Maps, website, stationery.</p>","DurationUnit":"day"},{"TaskID":12,"TaskName":"Old-office exit: utilities notices & lease handback checklist – إشعارات فصل الخدمات وقائمة تسليم المكتب القديم","StartDate":"2026-11-30T05:00:00.000Z","EndDate":"2026-12-02T14:00:00.000Z","Duration":3,"Predecessor":"10FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100}],"Progress":0,"color":"","info":"<p>Electricity, water, internet disconnection dates; landlord inspection date; meter readings.</p>","DurationUnit":"day"},{"TaskID":13,"TaskName":"Data backup & IT shutdown plan – النسخ الاحتياطي للبيانات وخطة إيقاف الأنظمة","StartDate":"2026-12-01T05:00:00.000Z","EndDate":"2026-12-02T14:00:00.000Z","Duration":2,"Predecessor":"6FS","resources":[{"resourceId":"Khalid","resourceName":"Khalid","unit":100}],"Progress":0,"color":"","info":"<p>Full backup verified off-site; shutdown/restart order for servers, network and workstations.</p>","DurationUnit":"day"},{"TaskID":14,"TaskName":"Final packing & labelling of desks and files – التغليف النهائي ووضع الملصقات","StartDate":"2026-12-03T05:00:00.000Z","EndDate":"2026-12-03T14:00:00.000Z","Duration":1,"Predecessor":"11FS,12FS,13FS,7FS","resources":[{"resourceId":"Anas","resourceName":"Anas","unit":100},{"resourceId":"Sara","resourceName":"Sara","unit":100},{"resourceId":"Khalid","